# Application Server
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
DEMO_MODE=true

# Database
DATABASE_URL=sqlite:///./orbit_forge.db

# LLM Advisory Configuration (Server-side only)
# LLM_API_KEY is the only secret credential variable
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# OIDC Keycloak & SAML Broker Federation
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/orbit-forge
OIDC_CLIENT_ID=orbit-forge-app
OIDC_AUDIENCE=orbit-forge-app
